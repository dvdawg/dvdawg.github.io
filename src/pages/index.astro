---
import LandingPage from "../layouts/LandingPage.astro";
import ProjectsContent from "../components/ProjectsContent.astro";
import MiscContent from "../components/MiscContent.astro";
---

<LandingPage pageTitle="David Kim">
  <div data-landing-panels>
    <section id="landing-projects" data-landing-panel="projects" aria-label="Projects" hidden>
      <ProjectsContent />
    </section>
    <section id="landing-misc" data-landing-panel="misc" aria-label="Misc" hidden>
      <MiscContent />
    </section>
  </div>
</LandingPage>
