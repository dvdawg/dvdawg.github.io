---
import '../../styles/deeptherm.css';
---

<figure class="dt-fig" data-dt-harm>
  <p class="dt-title">Figure 5 — the sectors that actually exist, and what they weigh</p>

  <div class="dt-controls">
    <div class="dt-control">
      <label for="dt-harm-k">moment order <span class="dt-value" data-lab-k>k = 4</span></label>
      <input id="dt-harm-k" type="range" min="1" max="10" step="1" value="4" data-k />
    </div>
    <div class="dt-control">
      <label for="dt-harm-d">D<sub>A</sub> <span class="dt-value" data-lab-d>4</span></label>
      <input id="dt-harm-d" type="range" min="2" max="20" step="1" value="4" data-d />
    </div>
  </div>

  <div class="dt-row">
    <div class="dt-panel" style="flex:1 1 320px">
      <p class="dt-panel-label">harmonic content of a k-th moment</p>
      <svg class="dt-stage" viewBox="0 0 340 260" data-bars role="img"></svg>
    </div>
    <div class="dt-panel" style="flex:1 1 300px">
      <p class="dt-panel-label">inherited amplitude and the design-time offset</p>
      <svg class="dt-stage" viewBox="0 0 330 260" data-curve role="img"></svg>
    </div>
  </div>

  <div class="dt-readout" data-readout></div>

  <figcaption>
    Under conjugation by <span class="dt-mono">U<sup>&otimes;k</sup></span> the operator space of a
    k-th moment splits into exactly <span class="dt-mono">k+1</span> unitary harmonics
    <span class="dt-mono">R<sub>0</sub> &hellip; R<sub>k</sub></span> &mdash; multiplicity free, so
    each one appears once and no choice is involved. <b>Left:</b> bar height is the exact
    squared-norm weight <span class="dt-mono">1/&alpha;<sub>k,&ell;</sub></span> with which each
    primitive harmonic <span class="dt-mono">C<sub>&ell;</sub></span> enters
    <span class="dt-mono">&delta;<sub>k</sub>&sup2;</span>, with the dimension of each harmonic
    printed underneath (they sum to <span class="dt-mono">N<sub>k</sub>&sup2;</span>). The
    <span class="dt-mono">&ell;=1</span> bar is not new information: it is an exact, rescaled copy
    of the ordinary one-copy deviation <span class="dt-mono">D<sub>1</sub></span>.
    <b>Right:</b> because that copy is amplified by
    <span class="dt-mono">&radic;(k(D<sub>A</sub>+1)/(D<sub>A</sub>+k))</span>, a fixed relative
    error threshold is crossed later at larger k by
    <span class="dt-mono">(log k)/(2&gamma;)</span> &mdash; a pure amplitude effect with a common
    rate, which saturates at <span class="dt-mono">&radic;(D<sub>A</sub>+1)</span> once
    k &gt;&gt; D<sub>A</sub>.
  </figcaption>
</figure>

<script>
  function setupHarm() {
    document.querySelectorAll('[data-dt-harm]').forEach((root) => {
      const el = root as HTMLElement;
      if (el.dataset.dtReady === '1') return;
      el.dataset.dtReady = '1';

      const ns = 'http://www.w3.org/2000/svg';
      const mk = (tag: string, a: Record<string, string | number>) => {
        const n = document.createElementNS(ns, tag);
        for (const key in a) n.setAttribute(key, String(a[key]));
        return n;
      };
      const txt = (x: number, y: number, s: string, extra: Record<string, string | number> = {}) => {
        const t = mk('text', { x, y, 'font-size': 9, fill: '#6b647f', ...extra });
        t.textContent = s;
        return t;
      };

      const LG: number[] = [];
      function lfact(n: number) {
        if (LG[n] !== undefined) return LG[n];
        let s = 0;
        for (let i = 2; i <= n; i++) s += Math.log(i);
        return (LG[n] = s);
      }
      const lbinom = (n: number, r: number) =>
        r < 0 || r > n ? -Infinity : lfact(n) - lfact(r) - lfact(n - r);
      const binom = (n: number, r: number) => Math.round(Math.exp(lbinom(n, r)));

      // dim of the SU(d) harmonic R_ell inside End(Sym^k C^d)
      const dimR = (d: number, l: number) =>
        l === 0 ? 1 : Math.round(((d + 2 * l - 1) / (d - 1)) * Math.pow(binom(d + l - 2, l), 2));

      // squared singular value of the full partial trace from level k down to ell
      function alpha(d: number, k: number, l: number) {
        return Math.exp(
          lfact(k - l) + lfact(k + l + d - 1) + 2 * lfact(l)
          - lfact(2 * l + d - 1) - 2 * lfact(k)
        );
      }
      const Nk = (d: number, k: number) => Math.exp(lbinom(d + k - 1, k));

      const sK = el.querySelector('[data-k]') as HTMLInputElement;
      const sD = el.querySelector('[data-d]') as HTMLInputElement;
      const svgB = el.querySelector('[data-bars]') as SVGSVGElement;
      const svgC = el.querySelector('[data-curve]') as SVGSVGElement;
      const readout = el.querySelector('[data-readout]') as HTMLElement;

      function render() {
        const k = +sK.value, d = +sD.value;
        (el.querySelector('[data-lab-k]') as HTMLElement).textContent = `k = ${k}`;
        (el.querySelector('[data-lab-d]') as HTMLElement).textContent = String(d);

        /* ---- panel 1: bars over ell ---- */
        while (svgB.firstChild) svgB.removeChild(svgB.firstChild);
        const W = 340, H = 260, m = { l: 40, r: 14, t: 16, b: 58 };
        const iw = W - m.l - m.r, ih = H - m.t - m.b;
        const dims: number[] = [], wts: number[] = [];
        for (let l = 0; l <= k; l++) {
          dims.push(dimR(d, l));
          wts.push(l === 0 ? 0 : 1 / alpha(d, k, l));
        }
        const wmax = Math.max(...wts, 1e-9);
        const slot = iw / (k + 1);
        const bw = Math.min(28, slot * 0.72);

        svgB.appendChild(mk('line', { x1: m.l, x2: W - m.r, y1: m.t + ih, y2: m.t + ih, stroke: '#d7d3e6', 'stroke-width': 1 }));
        for (let l = 0; l <= k; l++) {
          const cx = m.l + slot * (l + 0.5);
          const hw = (wts[l] / wmax) * (ih - 26);
          if (l === 0) {
            svgB.appendChild(mk('rect', {
              x: cx - bw / 2, y: m.t + ih - 3, width: bw, height: 3, fill: '#c9c5d6',
            }));
            svgB.appendChild(txt(cx, m.t + ih - 8, 'Haar', { 'text-anchor': 'middle', 'font-size': 8.5, fill: '#a8a2b8' }));
          } else {
            svgB.appendChild(mk('rect', {
              x: cx - bw / 2, y: m.t + ih - hw, width: bw, height: Math.max(hw, 1.2),
              fill: l === 1 ? '#0e7490' : '#7347f7', opacity: 0.92,
            }));
            svgB.appendChild(txt(cx, m.t + ih - hw - 5, wts[l].toFixed(2), {
              'text-anchor': 'middle', 'font-size': 8.5, fill: l === 1 ? '#0e7490' : '#7347f7',
            }));
          }
          svgB.appendChild(txt(cx, m.t + ih + 15, String(l), { 'text-anchor': 'middle' }));
          svgB.appendChild(txt(cx, m.t + ih + 27, String(dims[l]), {
            'text-anchor': 'middle', 'font-size': 8, fill: '#a8a2b8',
          }));
        }
        svgB.appendChild(txt(m.l - 4, m.t + ih + 15, 'ℓ', { 'text-anchor': 'end', 'font-size': 9 }));
        svgB.appendChild(txt(m.l - 4, m.t + ih + 27, 'dim', { 'text-anchor': 'end', 'font-size': 8, fill: '#a8a2b8' }));
        svgB.appendChild(txt(m.l + iw / 2, H - 16, 'bar height: weight 1/α(k,ℓ) of C_ℓ in δ_k²', { 'text-anchor': 'middle', 'font-size': 9 }));
        svgB.appendChild(txt(m.l + iw / 2, H - 4, 'ℓ = 0 Haar   •   ℓ = 1 ordinary   •   ℓ ≥ 2 primitive', { 'text-anchor': 'middle', 'font-size': 8.5, fill: '#9a94ab' }));

        /* ---- panel 2: inheritance factor vs k ---- */
        while (svgC.firstChild) svgC.removeChild(svgC.firstChild);
        const W2 = 330, H2 = 260, m2 = { l: 42, r: 14, t: 16, b: 40 };
        const iw2 = W2 - m2.l - m2.r, ih2 = H2 - m2.t - m2.b;
        const KMAX = 64;
        const fac = (kk: number) => Math.sqrt((kk * (d + 1)) / (d + kk));
        const fmax = Math.max(Math.sqrt(d + 1) * 1.08, fac(KMAX) * 1.05);
        const X = (kk: number) => m2.l + (Math.log(kk) / Math.log(KMAX)) * iw2;
        const Y = (v: number) => m2.t + ih2 - (v / fmax) * ih2;

        svgC.appendChild(mk('line', { x1: m2.l, x2: W2 - m2.r, y1: m2.t + ih2, y2: m2.t + ih2, stroke: '#d7d3e6', 'stroke-width': 1 }));
        svgC.appendChild(mk('line', { x1: m2.l, x2: m2.l, y1: m2.t, y2: m2.t + ih2, stroke: '#d7d3e6', 'stroke-width': 1 }));
        for (let v = 1; v <= fmax; v++) {
          svgC.appendChild(mk('line', { x1: m2.l, x2: W2 - m2.r, y1: Y(v), y2: Y(v), stroke: '#f1eff7', 'stroke-width': 1 }));
          svgC.appendChild(txt(m2.l - 5, Y(v) + 3.5, String(v), { 'text-anchor': 'end' }));
        }
        for (const kk of [1, 2, 4, 8, 16, 32, 64]) {
          svgC.appendChild(txt(X(kk), H2 - 22, String(kk), { 'text-anchor': 'middle' }));
        }
        svgC.appendChild(txt(m2.l + iw2 / 2, H2 - 8, 'moment order k  (log scale)', { 'text-anchor': 'middle', 'font-size': 9.5 }));

        // saturation line
        svgC.appendChild(mk('line', {
          x1: m2.l, x2: W2 - m2.r, y1: Y(Math.sqrt(d + 1)), y2: Y(Math.sqrt(d + 1)),
          stroke: '#be123c', 'stroke-width': 1, 'stroke-dasharray': '4 3',
        }));
        svgC.appendChild(txt(W2 - m2.r - 2, Y(Math.sqrt(d + 1)) - 5, '√(D_A+1)', { 'text-anchor': 'end', 'font-size': 8.5, fill: '#be123c' }));

        let path = '', ref = '';
        for (let i = 0; i <= 200; i++) {
          const kk = Math.exp((i / 200) * Math.log(KMAX));
          path += `${i === 0 ? 'M' : 'L'}${X(kk).toFixed(1)},${Y(fac(kk)).toFixed(1)}`;
          ref += `${i === 0 ? 'M' : 'L'}${X(kk).toFixed(1)},${Y(Math.min(Math.sqrt(kk), fmax)).toFixed(1)}`;
        }
        svgC.appendChild(mk('path', { d: ref, fill: 'none', stroke: '#c9c5d6', 'stroke-width': 1.4, 'stroke-dasharray': '2 3' }));
        svgC.appendChild(mk('path', { d: path, fill: 'none', stroke: '#0e7490', 'stroke-width': 2 }));
        svgC.appendChild(mk('circle', { cx: X(Math.max(k, 1)), cy: Y(fac(Math.max(k, 1))), r: 3.6, fill: '#0e7490' }));
        svgC.appendChild(txt(X(2.4), Y(Math.sqrt(2.4)) - 8, '√k', { fill: '#9a94ab', 'font-size': 8.5 }));

        /* ---- readout ---- */
        const nk = Nk(d, k);
        let inv = '';
        for (let l = 1; l <= Math.min(k, 4); l++) {
          inv += `<span><i>1/&alpha;<sub>${k},${l}</sub></i> ${(1 / alpha(d, k, l)).toFixed(3)}</span>`;
        }
        readout.innerHTML =
          `<span><i>N<sub>k</sub> = dim Sym<sup>k</sup></i> ${Math.round(nk)}</span>` +
          `<span><i>harmonics</i> ${k + 1}</span>` +
          `<span><i>&epsilon;<sub>k</sub> / &epsilon;<sub>1</sub> &ge;</i> ${fac(Math.max(k, 1)).toFixed(3)}</span>` +
          inv;
      }

      [sK, sD].forEach((s) => s.addEventListener('input', render));
      render();
    });
  }

  setupHarm();
  document.addEventListener('astro:after-swap', setupHarm);
</script>
