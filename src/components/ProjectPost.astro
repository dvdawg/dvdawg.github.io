---
const {
  title,
  url,
  description,
  image,
  imagePosition = "center",
  imageClass = "",
  year,
} = Astro.props;
---
<a href={url} class="group block h-full">
  <article class="relative h-72 overflow-hidden rounded-sm">
    {image && (
      <img
        src={image}
        alt={title}
        class={`absolute inset-0 h-full w-full object-cover ${imageClass}`.trim()}
        style={`object-position: ${imagePosition};`}
      />
    )}
    <div class="absolute bottom-0 left-0 right-0 h-24 border-t border-neutral-200 bg-[#f7f7fa] px-3 pt-3 transition-colors duration-200 group-hover:bg-light-accent">
      <div class="flex items-baseline justify-between gap-4">
        <h1 class="min-w-0 truncate text-lg font-normal leading-tight text-black">{title}</h1>
        {year && (
          <span class="shrink-0 font-mono text-[11px] font-bold text-dark-accent">{year}</span>
        )}
      </div>
      <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-gray-700">{description}</p>
    </div>
  </article>
</a>
<style>
  a {
    text-decoration: none !important;
  }
</style>
