      "inline-flex items-center rounded-full px-3 py-1 !text-black no-underline bg-light-accent hover:bg-accent-color transition-colors",
      textClass,
    ]}
    href="mailto:davidkm@berkeley.edu"
  >
    davidkm[at]berkeley[dot]edu
  </a>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="shrink-0 text-dark-accent"
    aria-hidden="true"
