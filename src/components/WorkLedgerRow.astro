---
const {
  title,
  url,
  description,
  image,
  imagePosition = "center",
  year,
} = Astro.props;
---
<a
  href={url}
  class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 border-b border-neutral-200 px-1 py-3 !no-underline transition-colors duration-200 hover:bg-light-accent sm:grid-cols-[120px_minmax(0,1fr)_auto]"
>
  <div class="hidden h-16 w-full overflow-hidden rounded-sm bg-neutral-200 sm:block">
    {image && (
      <img
        src={image}
        alt=""
        class="h-full w-full object-cover"
        style={`object-position: ${imagePosition};`}
        loading="eager"
      />
    )}
  </div>
  <div class="min-w-0">
    <h3 class="text-lg font-semibold leading-tight text-black">{title}</h3>
    <p class="mt-0.5 line-clamp-2 text-xs italic text-gray-600">{description}</p>
  </div>
  <div class="flex flex-col items-end gap-1 pr-1">
    <span class="font-mono text-[11px] text-dark-accent">{year}</span>
    <span class="text-sm leading-none text-dark-accent" aria-hidden="true">↗</span>
  </div>
</a>
